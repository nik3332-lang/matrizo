{
  "name": "@matrizo/api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply matrizo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply matrizo-db --remote"
  },
  "dependencies": {
    "@matrizo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}