{
  "expo": {
    "name": "Matrizo",
    "slug": "matrizo",
    "owner": "nikhilmatrizos-team",
    "extra": {
      "eas": {
        "projectId": "5e70cf48-6d95-46f7-92e6-7ab78f81e791"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "matrizo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f8f7",
    "ios": {
      "bundleIdentifier": "com.matrizo.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.matrizo.app",
      "adaptiveIcon": {
        "backgroundColor": "#18394b",
        "foregroundImage": "./assets/brand/adaptive.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18394b",
          "image": "./assets/brand/splash.png",
          "imageWidth": 130
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification.png",
          "color": "#18394b",
          "defaultChannel": "orders"
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
