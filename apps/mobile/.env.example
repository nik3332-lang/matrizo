# These EXPO_PUBLIC values are embedded in the app. Never put credentials here.
EXPO_PUBLIC_API_URL=https://matrizo-api.nikhilsinghal-official.workers.dev/api/v1
# Fill after creating/linking the Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_OWNER=
# Use a monitored, working address; configure incoming email before release.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Path to an ignored Firebase google-services.json (EAS file variable in builds).
GOOGLE_SERVICES_JSON=
